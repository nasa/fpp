#!/bin/bash

set -e

# Map uname output to the OS name used by GraalVM release assets
graal_os="$( uname -s | tr "[:upper:]" "[:lower:]")"
if [[ "$graal_os" == "darwin" ]]
then
  graal_os="macos"
fi

# Map uname output to the architecture name used by GraalVM release assets
graal_arch="$(uname -m)"
if [[ "$graal_arch" == "x86_64" ]] || [[ "$graal_arch" == "x64" ]]
then
  graal_arch="x64"
elif [[ "$graal_arch" == "arm64" ]] || [[ "$graal_arch" == "aarch64" ]]
then
  graal_arch="aarch64"
fi

# The GraalVM Community Edition release to use: graal_tag is the tag of the
# GitHub release, and graal_jdk is the JDK version that it provides
graal_tag="graal-25.3.4.1"
graal_jdk="25i3-25.0.4.1"
graal_ar="graalvm-community-jdk-${graal_jdk}_${graal_os}-${graal_arch}_bin.tar.gz"
graal_url="https://github.com/graalvm/graalvm-ce-builds/releases/download/${graal_tag}/${graal_ar}"

# Download Graal
echo "Downloading GraalVM from: ${graal_url}"
curl -fL -o "${graal_ar}" "${graal_url}"

# The name of the extracted directory does not match the name of the archive,
# so read it out of the archive
graal_dir="$(pwd)/$(tar -tzf "${graal_ar}" | head -1 | cut -d/ -f1)"

# Start fresh
if [ -d "${graal_dir}" ]
then
   rm -r "${graal_dir}"
fi

tar -xzf "${graal_ar}"
graal_bin="${graal_dir}/bin"
if [ ! -d "${graal_bin}" ]
then
    graal_bin="${graal_dir}/Contents/Home/bin"
fi

# native-image is bundled with GraalVM for JDK 21 and later, so there is
# nothing to install. Check that we resolved the layout of the release
# correctly.
if [ ! -x "${graal_bin}/native-image" ]
then
    echo "[ERROR] native-image not found in ${graal_bin}" 1>&2
    exit 1
fi

export PATH="${graal_bin}:${PATH}"
export FPP_GRAALVM_JAVA_HOME="$(dirname ${graal_bin})"

if [ -n "$GITHUB_ENV" ]
then
    echo PATH="${PATH}" >> $GITHUB_ENV
    echo FPP_GRAALVM_JAVA_HOME="${FPP_GRAALVM_JAVA_HOME}" >> $GITHUB_ENV
fi
