#!/bin/bash

# Resolve architecture
graal_arch="$(uname -m)"

# Override graal_arch when on amd64
if [[ "$graal_arch" == "x86_64" ]] || [[ "$graal_arch" == "x64" ]]
then
  graal_arch="x64"
elif [[ "$graal_arch" == "arm64" ]] || [[ "$graal_arch" == "aarch64" ]]
then
  graal_arch="aarch64"
fi

graal_os="$( uname -s | tr "[:upper:]" "[:lower:]")"
graal_ar="graalvm-jdk-17_${graal_os}-${graal_arch}_bin.tar.gz"
graal_dir="$(pwd)/graalvm-jdk-17"
graal_url="https://download.oracle.com/graalvm/17/latest/${graal_ar}"

# Start fresh
if [ -d "${graal_dir}" ]
then
   rm -r "${graal_dir}"
fi

# Download GraalVM
echo "Downloading GraalVM from: ${graal_url}"
curl -LO "${graal_url}" > "${graal_ar}"
tar -xzf "${graal_ar}"
graal_bin="${graal_dir}/bin"
if [ ! -d "${graal_bin}" ]
then
    graal_bin="${graal_dir}/Contents/Home/bin"
fi
export PATH="${graal_bin}:${PATH}"
export FPP_GRAALVM_JAVA_HOME="$(dirname ${graal_bin})"

if [ -n "$GITHUB_ENV" ]
then
    echo PATH="${PATH}" >> $GITHUB_ENV
    echo FPP_GRAALVM_JAVA_HOME="${FPP_GRAALVM_JAVA_HOME}" >> $GITHUB_ENV
fi
