#!/bin/sh

. ../../../scripts/test-utils.sh

fpp_syntax=../../../bin/fpp-syntax

update()
{
  args=$1
  infile=$2
  if test -n "$3"
  then
    outfile=$3
  else
    outfile=$infile
  fi
  echo "updating $outfile.ref.txt"
  $fpp_syntax $args $infile.fpp 2>&1 | remove_path_prefix > $outfile.ref.txt
}

for file in `find . -name '*.ref.txt'`
do
  rm $file
done

update "" comments
update "" embedded-tab
update "" illegal-character
update "" numeric-shift
update "" parse-error
update "" syntax
update "" syntax-kwd-names
update -a dictionary-specifier
update -a empty
update -a escaped-strings
update -a state-machine
update -a state-machine
update -a syntax syntax-ast
update -e cycle-1 include-cycle-1
update -e cycle-2 include-cycle-2
update -e include-missing-file
update -e include-parse-error
update -ea include-component
update -ea include-constant-1 include-constant-1
update -ea include-module
update -ea include-module-template
update -ea include-module-template-expand
update -ea include-state-machine
update -ea include-state-machine
update -ea include-subdir
update -ea include-topology
update -ea module-template
update -ea subdir/include-parent-dir
update -ea syntax syntax-include-ast
update -ea topology-ports
update -ea topology-ports

cat syntax.fpp | $fpp_syntax -ea 2>&1 > syntax-stdin.ref.txt

$fpp_syntax -ea include-module.fpp include-component.fpp 2>&1 > two-input-files.ref.txt
