#!/bin/sh

. ../../../scripts/test-utils.sh

fpp_syntax=../../../bin/fpp-syntax

run_test()
{
  args=$1
  infile=$2
  if test -n "$3"
  then
    outfile=$3
  else
    outfile=$infile
  fi
  $fpp_syntax $args $infile.fpp 2>&1 | remove_path_prefix > $outfile.out.txt
  diff -u $outfile.ref.txt $outfile.out.txt > $outfile.diff.txt 2>&1
}

comments()
{
  run_test "" comments
}

dictionary_specifier()
{
  run_test -a dictionary-specifier
}

embedded_tab()
{
  run_test "" embedded-tab
}

empty()
{
  run_test -a empty
}

escaped_strings()
{
  run_test -a escaped-strings
}

illegal_character()
{
  run_test "" illegal-character
}

include_component()
{
  run_test -ea include-component
}

include_constant_1()
{
  run_test -ea include-constant-1
}

include_cycle_1()
{
  run_test -e cycle-1 include-cycle-1
}

include_cycle_2()
{
  run_test -e cycle-2 include-cycle-2
}

include_missing_file()
{
  run_test -e include-missing-file
}

include_module()
{
  run_test -ea include-module
}

include_module_template()
{
  run_test -ea include-module-template
}

include_module_template_expand()
{
  run_test -ea include-module-template-expand
}

include_parent_dir()
{
  run_test -ea subdir/include-parent-dir
}

include_parse_error()
{
  run_test -e include-parse-error
}

include_state_machine()
{
  run_test -ea include-state-machine
}

include_subdir()
{
  run_test -ea include-subdir
}

include_topology()
{
  run_test -ea include-topology
}

module_template()
{
  run_test -ea module-template
}

numeric_shift()
{
  run_test "" numeric-shift
}

parse_error()
{
  run_test "" parse-error
}

state_machine()
{
  run_test -a state-machine
}

syntax()
{
  run_test "" syntax
}

syntax_ast()
{
  run_test -a syntax syntax-ast
}

syntax_include_ast()
{
  run_test -ea syntax syntax-include-ast
}

syntax_kwd_names()
{
  run_test "" syntax-kwd-names
}

syntax_stdin()
{
  cat syntax.fpp | $fpp_syntax -ea > syntax-stdin.out.txt
  diff -u syntax-stdin.ref.txt syntax-stdin.out.txt > syntax-stdin.diff.txt 2>&1
}

topology_ports()
{
  run_test -ea topology-ports
}

two_input_files()
{
  $fpp_syntax -ea include-module.fpp include-component.fpp 2>&1 > two-input-files.out.txt
  diff -u two-input-files.ref.txt two-input-files.out.txt > two-input-files.diff.txt 2>&1
}

tests="
comments
dictionary_specifier
embedded_tab
empty
escaped_strings
illegal_character
include_component
include_constant_1
include_cycle_1
include_cycle_2
include_missing_file
include_module
include_module_template
include_module_template_expand
include_parent_dir
include_parse_error
include_state_machine
include_subdir
include_topology
module_template
numeric_shift
parse_error
state_machine
syntax
syntax_ast
syntax_include_ast
syntax_kwd_names
syntax_stdin
topology_ports
two_input_files
"

run_suite $tests
