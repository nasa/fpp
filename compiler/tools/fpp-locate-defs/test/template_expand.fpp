# fpp-locate-defs expands templates so that the definitions generated by an
# expansion are located. Here module Expanded expands template Tmpl, producing
# Expanded.GenComp and Expanded.GenArr; both must appear in the output so that
# other files can locate these expansion-generated symbols.
port P

module Lib {
  module template Tmpl(constant n: U32) {
    passive component GenComp {
      sync input port pIn: P
    }
    array GenArr = [n] U32
  }
}

module Expanded {
  expand Lib.Tmpl(constant 3)
}
