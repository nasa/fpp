#!/bin/sh

. ../../../scripts/test-utils.sh

fpp_to_fpp=../../../bin/fpp-to-fpp

update()
{
  args=$1
  infile=$2
  if test -n "$3"
  then
    outfile=$3
  else
    outfile=$infile
  fi
  $fpp_to_fpp $args $infile.fpp 2>&1 | remove_path_prefix > $outfile.ref.txt
}

for file in `find . -name '*.ref.txt'`
do
  rm $file
done

. ./tests.sh

# Default update ref
for t in $tests
do
  echo "
$t()
{
  update '' $t
}"
done > default-update-ref.sh
. ./default-update-ref.sh

dictionary_specifier()
{
  update '' ../../fpp-syntax/test/dictionary-specifier dictionary_specifier
}

escaped_strings()
{
  update '' escaped_strings
}

include()
{
  update '-e' ../../fpp-syntax/test/syntax include
}

kwd_names()
{
  update '' kwd_names
}

module_template_expand()
{
  update '-e' module_template_expand
}

module_template_import()
{
  update '-e -i module_template_def.fpp' module_template_import
}

module_template_include()
{
  update '-e' module_template_include
}

no_include()
{
  update '' ../../fpp-syntax/test/syntax no_include
}

state_machine()
{
  update '' ../../fpp-syntax/test/state-machine state_machine
}

state_machine_expand()
{
  update '-e' ../../fpp-syntax/test/state-machine state_machine_expand
}

for t in $tests
do
  echo "updating ref output for $t"
  $t
done
