#!/bin/sh

. ../../../scripts/test-utils.sh

fpp_to_fpp=../../../bin/fpp-to-fpp
fpp_syntax=../../../bin/fpp-syntax

compare()
{
  outfile=$1
  diff -u $outfile.ref.txt $outfile.out.txt > $outfile.diff.txt 2>&1
}

run_test()
{
  args=$1
  infile=$2
  if test -n "$3"
  then
    outfile=$3
  else
    outfile=$infile
  fi
  $fpp_to_fpp $args $infile.fpp 2>&1 | remove_path_prefix > $outfile.out.txt
  compare $outfile
}

. ./tests.sh

# Default tests
for t in $tests
do
  echo "
$t()
{
  run_test '' $t
}"
done > default-tests.sh
. ./default-tests.sh

dictionary_specifier()
{
  run_test '' ../../fpp-syntax/test/dictionary-specifier dictionary_specifier && \
    $fpp_syntax dictionary_specifier.out.txt
}

include()
{
  run_test '-e' ../../fpp-syntax/test/syntax include && \
    $fpp_syntax include.out.txt
}

kwd_names()
{
  run_test '' kwd_names && \
    $fpp_syntax kwd_names.out.txt
}

module_template_expand()
{
  run_test '-e' module_template_expand && \
    $fpp_syntax module_template_expand.out.txt

}

module_template_import()
{
  run_test '-e -i module_template_def.fpp' module_template_import && \
    $fpp_syntax module_template_import.out.txt
}

module_template_include()
{
  run_test '-e' module_template_include && \
    $fpp_syntax module_template_include.out.txt
}

no_include()
{
  run_test '' ../../fpp-syntax/test/syntax no_include && \
    $fpp_syntax no_include.out.txt
}

state_machine()
{
  run_test '' ../../fpp-syntax/test/state-machine state_machine && \
    $fpp_syntax state_machine.out.txt
}

state_machine_expand()
{
  run_test '-e' ../../fpp-syntax/test/state-machine state_machine_expand && \
    $fpp_syntax state_machine_expand.out.txt
}

run_suite $tests
